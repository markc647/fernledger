{
  "name": "fernledger",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen && tsc -b && vite build",
    "gen": "tsr generate && tsc -p tsconfig.api-types.json",
    "typecheck": "npm run gen && tsc -b",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint",
    "seed": "node scripts/seed.mjs",
    "test:e2e": "playwright test",
    "test:e2e:shards": "node scripts/e2e-shards.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "migrations:check": "node scripts/check-migrations.mjs",
    "sample-db": "node scripts/sample-db.mjs",
    "scan": "node scripts/scan.mjs",
    "scan:selftest": "node scripts/scan-selftest.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:scripts && npm run migrations:check && npm run scan && npm run scan:selftest",
    "prepare": "node scripts/install-hooks.mjs",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "restore": "node scripts/restore.mjs",
    "restore:practice": "node scripts/restore-practice.mjs",
    "teardown": "node scripts/teardown.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.1",
    "oxlint": "^1.89.0",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.149.0"
  }
}
