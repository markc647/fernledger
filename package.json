{
  "name": "fernledger",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen && tsc -b && vite build",
    "gen": "tsr generate && tsc -p tsconfig.api-types.json",
    "typecheck": "npm run gen && tsc -b",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint",
    "seed": "node scripts/seed.mjs",
    "test:e2e": "playwright test",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "migrations:check": "node scripts/check-migrations.mjs",
    "sample-db": "node scripts/sample-db.mjs",
    "scan": "node scripts/scan.mjs",
    "scan:selftest": "node scripts/scan-selftest.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:scripts && npm run migrations:check && npm run scan && npm run scan:selftest",
    "prepare": "node scripts/install-hooks.mjs",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "restore": "node scripts/restore.mjs",
    "teardown": "node scripts/teardown.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.63.0",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
