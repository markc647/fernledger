{
  // Tests run inside workerd and get the `cloudflare:test` types; the production Worker does not.
  "extends": "./tsconfig.worker.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker-test.tsbuildinfo",
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["worker", "worker-configuration.d.ts"],
  "exclude": []
}
